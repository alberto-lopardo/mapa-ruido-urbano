{
  "version": "1.0",
  "name": "Mapa de Ruido Urbano - ISO 9613-2",
  "description": "Nivel equivalente Leq ponderado A - Trama urbana sintetica",
  "author": "Alberto Lopardo",
  "crs": "EPSG:3857",
  "center": [
    300.0,
    250.0
  ],
  "zoom": 14,
  "layers": [
    {
      "id": "background",
      "type": "background",
      "source": "openfreemap",
      "visible": true,
      "opacity": 1.0
    },
    {
      "id": "isofonas_poligonos",
      "type": "fill",
      "name": "Isofonas (poligonos)",
      "source": {
        "type": "geojson",
        "url": "https://raw.githubusercontent.com/alberto-lopardo/mapa-ruido-urbano/main/isofonas_poligonos.geojson"
      },
      "visible": true,
      "style": {
        "type": "simple",
        "paint": {
          "fill-color": [
            "get",
            "fill"
          ],
          "fill-opacity": [
            "get",
            "fill-opacity"
          ],
          "fill-outline-color": [
            "get",
            "stroke"
          ]
        }
      }
    },
    {
      "id": "isofonas_lineas",
      "type": "line",
      "name": "Isofonas (lineas)",
      "source": {
        "type": "geojson",
        "url": "https://raw.githubusercontent.com/alberto-lopardo/mapa-ruido-urbano/main/isofonas_lineas.geojson"
      },
      "visible": true,
      "style": {
        "type": "simple",
        "paint": {
          "line-color": [
            "get",
            "stroke"
          ],
          "line-width": [
            "get",
            "stroke-width"
          ],
          "line-opacity": [
            "get",
            "stroke-opacity"
          ]
        }
      }
    },
    {
      "id": "edificios",
      "type": "fill",
      "name": "Edificios",
      "source": {
        "type": "geojson",
        "url": "https://raw.githubusercontent.com/alberto-lopardo/mapa-ruido-urbano/main/edificios.geojson"
      },
      "visible": true,
      "style": {
        "type": "simple",
        "paint": {
          "fill-color": [
            "get",
            "fill"
          ],
          "fill-opacity": [
            "get",
            "fill-opacity"
          ],
          "fill-outline-color": [
            "get",
            "stroke"
          ]
        }
      }
    },
    {
      "id": "zonas_excedencia",
      "type": "fill",
      "name": "Zonas de excedencia normativa",
      "source": {
        "type": "geojson",
        "url": "https://raw.githubusercontent.com/alberto-lopardo/mapa-ruido-urbano/main/zonas_excedencia.geojson"
      },
      "visible": true,
      "style": {
        "type": "simple",
        "paint": {
          "fill-color": [
            "get",
            "fill"
          ],
          "fill-opacity": [
            "get",
            "fill-opacity"
          ],
          "fill-outline-color": [
            "get",
            "stroke"
          ]
        }
      }
    },
    {
      "id": "fuente_carretera",
      "type": "line",
      "name": "Carretera principal",
      "source": {
        "type": "geojson",
        "url": "https://raw.githubusercontent.com/alberto-lopardo/mapa-ruido-urbano/main/fuentes_acusticas.geojson",
        "filter": [
          "==",
          [
            "get",
            "tipo_fuente"
          ],
          "lineal"
        ]
      },
      "visible": true,
      "style": {
        "type": "simple",
        "paint": {
          "line-color": [
            "get",
            "stroke"
          ],
          "line-width": [
            "get",
            "stroke-width"
          ]
        }
      }
    },
    {
      "id": "fuente_industrial",
      "type": "circle",
      "name": "Foco industrial",
      "source": {
        "type": "geojson",
        "url": "https://raw.githubusercontent.com/alberto-lopardo/mapa-ruido-urbano/main/fuentes_acusticas.geojson",
        "filter": [
          "==",
          [
            "get",
            "tipo_fuente"
          ],
          "puntual"
        ]
      },
      "visible": true,
      "style": {
        "type": "simple",
        "paint": {
          "circle-color": [
            "get",
            "marker-color"
          ],
          "circle-radius": [
            "get",
            "marker-size"
          ],
          "circle-stroke-color": "#FFFFFF",
          "circle-stroke-width": 2
        }
      }
    }
  ]
}