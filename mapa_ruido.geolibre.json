{
  "version": "0.2.0",
  "name": "Mapa de Ruido Urbano - ISO 9613-2",
  "mapView": {
    "center": [
      300.0,
      250.0
    ],
    "zoom": 14,
    "bearing": 0,
    "pitch": 0
  },
  "basemapStyleUrl": "https://demotiles.maplibre.com/style.json",
  "basemapVisible": true,
  "basemapOpacity": 1.0,
  "layers": [
    {
      "id": "mapa_ruido_Leq",
      "name": "Nivel Leq (dBA)",
      "type": "raster",
      "source": {
        "type": "geotiff",
        "url": "./mapa_ruido_Leq.tif"
      },
      "visible": true,
      "opacity": 0.85,
      "style": {
        "rasterOpacity": 0.85
      }
    },
    {
      "id": "isofonas_poligonos",
      "name": "Isofonas (poligonos)",
      "type": "geojson",
      "source": {
        "type": "geojson",
        "url": "./isofonas_poligonos.geojson"
      },
      "visible": true,
      "opacity": 1.0,
      "style": {
        "fillColor": "#A8D8A8",
        "fillOpacity": 0.65,
        "strokeColor": "#888888",
        "strokeWidth": 0.5
      }
    },
    {
      "id": "isofonas_lineas",
      "name": "Isofonas (lineas)",
      "type": "geojson",
      "source": {
        "type": "geojson",
        "url": "./isofonas_lineas.geojson"
      },
      "visible": true,
      "opacity": 1.0,
      "style": {
        "strokeColor": "#5CB85C",
        "strokeWidth": 2.0,
        "strokeOpacity": 0.9
      }
    },
    {
      "id": "edificios",
      "name": "Edificios",
      "type": "geojson",
      "source": {
        "type": "geojson",
        "url": "./edificios.geojson"
      },
      "visible": true,
      "opacity": 1.0,
      "style": {
        "fillColor": "#BFC5CC",
        "fillOpacity": 0.85,
        "strokeColor": "#4A4A4A",
        "strokeWidth": 0.8
      }
    },
    {
      "id": "zonas_excedencia",
      "name": "Zonas de excedencia normativa",
      "type": "geojson",
      "source": {
        "type": "geojson",
        "url": "./zonas_excedencia.geojson"
      },
      "visible": true,
      "opacity": 1.0,
      "style": {
        "fillColor": "#FFA500",
        "fillOpacity": 0.35,
        "strokeColor": "#FFA500",
        "strokeWidth": 1.5
      }
    },
    {
      "id": "fuente_carretera",
      "name": "Carretera principal",
      "type": "geojson",
      "source": {
        "type": "geojson",
        "url": "./fuentes_acusticas.geojson",
        "filter": [
          "==",
          [
            "get",
            "tipo_fuente"
          ],
          "lineal"
        ]
      },
      "visible": true,
      "opacity": 1.0,
      "style": {
        "strokeColor": "#555555",
        "strokeWidth": 4.0,
        "strokeOpacity": 1.0
      }
    },
    {
      "id": "fuente_industrial",
      "name": "Foco industrial",
      "type": "geojson",
      "source": {
        "type": "geojson",
        "url": "./fuentes_acusticas.geojson",
        "filter": [
          "==",
          [
            "get",
            "tipo_fuente"
          ],
          "puntual"
        ]
      },
      "visible": true,
      "opacity": 1.0,
      "style": {
        "circleColor": "#8B0000",
        "circleRadius": 12,
        "circleStrokeColor": "#FFFFFF",
        "circleStrokeWidth": 2
      }
